<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Navy header -->
        <View
            android:id="@+id/headerBg"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/bg_header" />

        <TextView
            android:id="@+id/tvBuild"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="72dp"
            android:text="Build"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tvBuild"
            android:layout_toEndOf="@id/tvBuild"
            android:text="Track"
            android:textColor="@color/gold"
            android:textSize="36sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/accentBar"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_below="@id/tvBuild"
            android:layout_marginStart="28dp"
            android:layout_marginTop="6dp"
            android:background="@color/gold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/accentBar"
            android:layout_marginStart="28dp"
            android:layout_marginTop="8dp"
            android:text="Construction progress, made transparent"
            android:textColor="@color/header_sub"
            android:textSize="14sp" />

        <!-- White card that floats over the header -->
        <RelativeLayout
            android:id="@+id/cardForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/headerBg"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your account"
                android:textColor="@color/navy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvWelcome"
                android:layout_marginTop="4dp"
                android:text="Register, or log in if you already have an account"
                android:textColor="@color/grey_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvHint"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_input"
                android:hint="First name (required)"
                android:inputType="textPersonName"
                android:textColor="@color/ink"
                android:textColorHint="@color/grey_text"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etFirstName"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="Last name (optional)"
                android:inputType="textPersonName"
                android:textColor="@color/ink"
                android:textColorHint="@color/grey_text"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etLastName"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="@color/ink"
                android:textColorHint="@color/grey_text"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/etEmail"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="Password"
                android:inputType="textPassword"
                android:textColor="@color/ink"
                android:textColorHint="@color/grey_text"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbShowPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/etPassword"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/gold"
                android:text="Show password"
                android:textColor="@color/grey_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRoleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cbShowPassword"
                android:layout_marginTop="16dp"
                android:text="I am a"
                android:textColor="@color/navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvRoleLabel"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbManager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_option"
                    android:buttonTint="@color/gold"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:text="Manager"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbEngineer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_option"
                    android:buttonTint="@color/gold"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:text="On-Site Engineer"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/rbBuyer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_option"
                    android:buttonTint="@color/gold"
                    android:minHeight="52dp"
                    android:paddingStart="12dp"
                    android:text="Buyer"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@id/rgRole"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_gold"
                android:backgroundTint="@null"
                android:text="Register"
                android:textAllCaps="false"
                android:textColor="@color/navy_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@id/btnRegister"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline"
                android:backgroundTint="@null"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@color/navy"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/btnLogin"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Name and role are needed only when registering"
                android:textColor="@color/grey_text"
                android:textSize="12sp" />
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>