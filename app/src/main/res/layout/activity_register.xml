<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_entry_screen"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp">

        <!-- Deep Espresso header: name, tagline, construction skyline -->
        <RelativeLayout
            android:id="@+id/heroBand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_entry_header"
            android:paddingStart="28dp"
            android:paddingTop="72dp"
            android:paddingEnd="28dp"
            android:paddingBottom="46dp">

            <TextView
                android:id="@+id/tvCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.28"
                android:text="CONSTRUCTION TRANSPARENCY"
                android:textColor="@color/entry_amber"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvCaption"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBuild"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/build"
                    android:textColor="@color/entry_bg"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/track"
                    android:textColor="@color/entry_amber"
                    android:textSize="42sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/wordmark"
                android:layout_marginTop="4dp"
                android:text="@string/construction_progress_made_transparent"
                android:textColor="@color/entry_line"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_below="@id/tvSubtitle"
                android:layout_marginTop="18dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/ic_skyline" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/cardForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/heroBand"
            android:layout_marginStart="24dp"
            android:layout_marginTop="-26dp"
            android:elevation="8dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_your_account"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/fill_in_your_details_to_register"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/first_name_required"
                android:inputType="textPersonName"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" 
                android:autofillHints="givenName"/>

            <EditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/last_name_optional"
                android:inputType="textPersonName"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" 
                android:autofillHints="familyName"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" 
                android:autofillHints="emailAddress"/>

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/mobile_number"
                android:inputType="phone"
                android:maxLength="14"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" 
                android:autofillHints="phone"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_entry_input"
                android:hint="@string/password"
                android:inputType="textPassword"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" 
                android:autofillHints="password"/>

            <CheckBox
                android:id="@+id/cbShowPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="?attr/colorPrimary"
                android:text="@string/show_password"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRoleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/i_am_a"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbManager"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_option"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:buttonTint="?attr/colorPrimary"
                    android:text="@string/manager"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbEngineer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_option"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:buttonTint="?attr/colorPrimary"
                    android:text="@string/on_site_engineer"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbBuyer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_role_option"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:buttonTint="?attr/colorPrimary"
                    android:text="@string/buyer"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="@string/register"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/entry_button"
                app:cornerRadius="16dp"
                 />

            <Button
                android:id="@+id/btnGoLogin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:text="@string/i_already_have_an_account"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="@color/entry_orange" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardForm"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="BuildTrack  ·  Every phase, in view"
            android:textColor="@color/entry_text_dim"
            android:textSize="12sp" />
    </RelativeLayout>
</ScrollView>
