<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="52dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manager"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnMenu"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvRole"
            android:layout_marginTop="2dp"
            android:text="@string/welcome"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <Button
            style="@style/Widget.Material3.Button.TextButton"
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignTop="@id/tvRole"
            android:layout_alignParentEnd="true"
            android:text="@string/menu"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/sectionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="@string/projects"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnNewProject"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginEnd="10dp"/>

        <Button
            style="@style/Widget.Material3.Button.TextButton"
            android:id="@+id/btnNewProject"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:text="@string/new_project"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProjects"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/sectionRow"
        android:clipToPadding="false"
        android:padding="16dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/sectionRow"
        android:layout_margin="24dp"
        android:text="@string/loading"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp" />
</RelativeLayout>