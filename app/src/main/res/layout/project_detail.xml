<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manager_body">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_manager"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Project Detail"
            android:textColor="@color/manager_crimson_light"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvRole"
            android:layout_marginTop="4dp"
            android:text="Skyline Towers - Phase 1"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/manager_crimson"
            app:cornerRadius="14dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Overall Progress Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overall Project Completion"
                        android:textColor="@color/ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOverallPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="68%"
                        android:textColor="@color/manager_crimson"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Green line when 100%, crimson otherwise -->
                    <ProgressBar
                        android:id="@+id/pbOverallDetail"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:progress="68"
                        android:progressTint="@color/manager_crimson" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Action Buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Quick Actions"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <Button
                    android:id="@+id/btnNavLogs"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Daily Logs"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/manager_crimson"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnNavAssign"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Assign Team"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/manager_crimson"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnNavComments"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Site Comments"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/manager_crimson"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnNavPostUpdate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:text="Post Photo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/manager_crimson"
                    app:cornerRadius="12dp" />
            </GridLayout>

            <!-- SAVE PROGRESS BUTTON - PROMINENTLY VISIBLE AT THE TOP -->
            <Button
                android:id="@+id/btnSaveChanges"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="✔ Save Phase Progress"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/manager_crimson"
                app:cornerRadius="14dp" />

            <!-- Phase Sliders -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="Construction Phases (Adjust with Sliders)"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/phasesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>