<?xml version="1.0" encoding="utf-8"?>
<!-- Entry text boxes: white, sand border, orange border while typing -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/entry_card" />
            <stroke android:width="1.5dp" android:color="@color/entry_orange" />
            <corners android:radius="14dp" />
            <padding android:bottom="14dp" android:left="16dp" android:right="16dp" android:top="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/entry_card" />
            <stroke android:width="1dp" android:color="@color/entry_line" />
            <corners android:radius="14dp" />
            <padding android:bottom="14dp" android:left="16dp" android:right="16dp" android:top="14dp" />
        </shape>
    </item>
</selector>
