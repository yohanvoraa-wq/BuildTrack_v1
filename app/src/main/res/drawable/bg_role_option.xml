<?xml version="1.0" encoding="utf-8"?>
<!-- Role rows: white with a sand border; warm amber tint and orange border when chosen -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/entry_chip_on" />
            <stroke android:width="1.5dp" android:color="@color/entry_orange" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/entry_card" />
            <stroke android:width="1dp" android:color="@color/entry_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
